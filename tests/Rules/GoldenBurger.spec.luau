local GoldenBurger = require("../../src/shared/Rules/GoldenBurger")
local Config = require("../../src/shared/Config")

local CFG = { appearAfterSeconds = 180, points = 2, droppedSeconds = 10 }

return function(t)
	t.test("config: appears 3 minutes in, worth 2", function()
		t.eq(Config.GoldenBurger.appearAfterSeconds, 180)
		t.eq(Config.GoldenBurger.points, 2)
		t.truthy(Config.GoldenBurger.points < Config.PointsToWin, "worth less than a win")
	end)

	t.test("waits until 3:00 into the match, then appears once", function()
		local g = GoldenBurger.new()
		t.eq(g.status, "Waiting")
		local ev
		g, ev = GoldenBurger.tick(g, 179.9, 100, CFG)
		t.eq(g.status, "Waiting")
		t.eq(ev, nil)
		g, ev = GoldenBurger.tick(g, 180, 101, CFG)
		t.eq(g.status, "OnBridge")
		t.eq(ev, "Appeared")
		g, ev = GoldenBurger.tick(g, 400, 300, CFG)
		t.eq(ev, nil, "no second appearance")
	end)

	t.test("any team can grab it from the bridge; not while carrying other food", function()
		local g = GoldenBurger.tick(GoldenBurger.new(), 200, 0, CFG)
		local g2, err = GoldenBurger.pickUp(g, { id = "a", team = "Red", carrying = true })
		t.eq(err, "already carrying")
		t.eq(g2.status, "OnBridge")
		g2, err = GoldenBurger.pickUp(g, { id = "b", team = "Blue", carrying = false })
		t.eq(err, nil)
		t.eq(g2.status, "Carried")
		t.eq(g2.carrier, "b")
		t.eq(g2.carrierTeam, "Blue")
		local _, err2 = GoldenBurger.pickUp(GoldenBurger.new(), { id = "c", team = "Red", carrying = false })
		t.eq(err2, "not available", "can't grab before it appears")
	end)

	t.test("scores 2 only at the carrier's own drop-off, then is gone for the match", function()
		local g = GoldenBurger.tick(GoldenBurger.new(), 200, 0, CFG)
		g = GoldenBurger.pickUp(g, { id = "b", team = "Blue", carrying = false })
		local same, pts = GoldenBurger.score(g, "Red", CFG)
		t.eq(pts, nil, "wrong drop-off")
		t.eq(same.status, "Carried")
		local done, pts2 = GoldenBurger.score(g, "Blue", CFG)
		t.eq(pts2, 2)
		t.eq(done.status, "Scored")
		local again = GoldenBurger.tick(done, 999, 999, CFG)
		t.eq(again.status, "Scored")
	end)

	t.test("dropped: anyone can pick it up; untouched it goes back to the bridge", function()
		local g = GoldenBurger.tick(GoldenBurger.new(), 200, 0, CFG)
		g = GoldenBurger.pickUp(g, { id = "b", team = "Blue", carrying = false })
		g = GoldenBurger.drop(g, 50)
		t.eq(g.status, "Dropped")
		local red = GoldenBurger.pickUp(g, { id = "r", team = "Red", carrying = false })
		t.eq(red.status, "Carried")
		t.eq(red.carrierTeam, "Red")
		local back, ev = GoldenBurger.tick(g, 300, 60, CFG)
		t.eq(back.status, "OnBridge")
		t.eq(ev, "Returned")
		local still = GoldenBurger.tick(g, 300, 59.9, CFG)
		t.eq(still.status, "Dropped")
	end)

	t.test("drop only from Carried", function()
		t.throws(function()
			GoldenBurger.drop(GoldenBurger.new(), 0)
		end)
	end)
end

local Cooldown = require("../../src/shared/Rules/Cooldown")

return function(t)
	t.test("ready at start", function()
		local c = Cooldown.new(5)
		t.truthy(c:ready(0))
		t.eq(c:remaining(0), 0)
	end)

	t.test("trigger starts the cooldown", function()
		local c = Cooldown.new(5)
		t.truthy(c:trigger(10))
		t.falsy(c:ready(14.9))
		t.near(c:remaining(12), 3)
		t.truthy(c:ready(15))
	end)

	t.test("trigger while cooling down fails and does not reset timer", function()
		local c = Cooldown.new(5)
		c:trigger(10)
		t.falsy(c:trigger(12))
		t.truthy(c:ready(15))
	end)

	t.test("reset clears cooldown", function()
		local c = Cooldown.new(5)
		c:trigger(10)
		c:reset()
		t.truthy(c:ready(10))
	end)

	t.test("negative duration rejected", function()
		t.throws(function()
			Cooldown.new(-1)
		end)
	end)
end

local FoodState = require("../../src/shared/Rules/FoodState")

local cfg = { droppedSeconds = 10, restockSeconds = 4 }
local blueRaider = { id = "b1", team = "Blue", carrying = false }
local blueMate = { id = "b2", team = "Blue", carrying = false }
local redDefender = { id = "r1", team = "Red", carrying = false }

return function(t)
	t.test("new food sits in its pantry", function()
		local f = FoodState.new("Red", "Pizza")
		t.eq(f.status, "Pantry")
		t.eq(f.owner, "Red")
		t.eq(f.foodType, "Pizza")
	end)

	t.test("enemy grabs from pantry", function()
		local f, err = FoodState.pickUp(FoodState.new("Red", "Taco"), blueRaider)
		t.eq(err, nil)
		t.eq(f.status, "Carried")
		t.eq(f.carrier, "b1")
		t.eq(f.carrierTeam, "Blue")
	end)

	t.test("cannot grab own team's food from pantry", function()
		local f0 = FoodState.new("Red", "Taco")
		local f, err = FoodState.pickUp(f0, redDefender)
		t.eq(err, "own pantry")
		t.eq(f, f0)
	end)

	t.test("cannot carry two foods", function()
		local _, err = FoodState.pickUp(FoodState.new("Red", "Taco"), { id = "b1", team = "Blue", carrying = true })
		t.eq(err, "already carrying")
	end)

	t.test("score at own dropoff gives the carrier team a point and restocks", function()
		local f = FoodState.pickUp(FoodState.new("Red", "Sushi"), blueRaider)
		local f2, scoredFor = FoodState.score(f, "Blue", 100, cfg)
		t.eq(scoredFor, "Blue")
		t.eq(f2.status, "Restocking")
		t.eq(f2.readyAt, 104)
		t.eq(f2.carrier, nil)
	end)

	t.test("score at wrong dropoff does nothing", function()
		local f = FoodState.pickUp(FoodState.new("Red", "Sushi"), blueRaider)
		local f2, scoredFor = FoodState.score(f, "Red", 100, cfg)
		t.eq(scoredFor, nil)
		t.eq(f2.status, "Carried")
	end)

	t.test("score when not carried does nothing", function()
		local f = FoodState.new("Red", "Sushi")
		local f2, scoredFor = FoodState.score(f, "Blue", 100, cfg)
		t.eq(scoredFor, nil)
		t.eq(f2, f)
	end)

	t.test("restock returns food to pantry after delay", function()
		local f = FoodState.pickUp(FoodState.new("Red", "Sushi"), blueRaider)
		f = FoodState.score(f, "Blue", 100, cfg)
		t.eq(FoodState.tick(f, 103.9, cfg).status, "Restocking")
		t.eq(FoodState.tick(f, 104, cfg).status, "Pantry")
	end)

	t.test("drop leaves food on the field", function()
		local f = FoodState.pickUp(FoodState.new("Red", "Burger"), blueRaider)
		f = FoodState.drop(f, 50)
		t.eq(f.status, "Dropped")
		t.eq(f.droppedAt, 50)
		t.eq(f.carrier, nil)
		t.eq(f.carrierTeam, "Blue", "remembers raiding team")
	end)

	t.test("drop of non-carried food errors", function()
		t.throws(function()
			FoodState.drop(FoodState.new("Red", "Burger"), 1)
		end)
	end)

	t.test("dropped food expires back to pantry after 10s", function()
		local f = FoodState.drop(FoodState.pickUp(FoodState.new("Red", "Burger"), blueRaider), 50)
		local f2, ev = FoodState.tick(f, 59.9, cfg)
		t.eq(f2.status, "Dropped")
		t.eq(ev, nil)
		f2, ev = FoodState.tick(f, 60, cfg)
		t.eq(f2.status, "Pantry")
		t.eq(ev, "Expired")
	end)

	t.test("enemy (owner) touch returns dropped food", function()
		local f = FoodState.drop(FoodState.pickUp(FoodState.new("Red", "Burger"), blueRaider), 50)
		local f2, ev = FoodState.touchDropped(f, redDefender)
		t.eq(ev, "Returned")
		t.eq(f2.status, "Pantry")
	end)

	t.test("teammate touch picks dropped food up", function()
		local f = FoodState.drop(FoodState.pickUp(FoodState.new("Red", "Burger"), blueRaider), 50)
		local f2, ev = FoodState.touchDropped(f, blueMate)
		t.eq(ev, "PickedUp")
		t.eq(f2.status, "Carried")
		t.eq(f2.carrier, "b2")
	end)

	t.test("teammate already carrying cannot pick dropped food", function()
		local f = FoodState.drop(FoodState.pickUp(FoodState.new("Red", "Burger"), blueRaider), 50)
		local f2, ev = FoodState.touchDropped(f, { id = "b3", team = "Blue", carrying = true })
		t.eq(ev, nil)
		t.eq(f2.status, "Dropped")
	end)

	t.test("touchDropped on non-dropped food is a no-op", function()
		local f = FoodState.new("Red", "Burger")
		local f2, ev = FoodState.touchDropped(f, blueMate)
		t.eq(ev, nil)
		t.eq(f2, f)
	end)
end
